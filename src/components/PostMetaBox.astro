---
import Link from './Link';

import type { Post } from '../blog/lib';
import { getSeriesBySlug, getTagNames } from '../blog/lib';
import { author, localMeImage } from '../config/site';

type Props = {
  post: Post;
};

const { post } = Astro.props;

const { publishedAt, updatedAt, tags, series, draft } = post.data;
const seriesEntry = series ? await getSeriesBySlug(series) : undefined;
const tagNames = await getTagNames();
---
<section class="flex-card flex-col gap-2 items-center text-sm py-4">
  <!-- Dates -->
  <div class="mb-2">
    {draft ? (
      <span>Draft</span>
    ) : publishedAt ? (
      <time datetime={publishedAt}>
        Published {new Date(publishedAt).toLocaleDateString()}
      </time>
    ) : null}
    {updatedAt && (
      <> · Updated {new Date(updatedAt).toLocaleDateString()}</>
    )}
  </div>

  <!-- Author -->
  <div class="flex items-center gap-2 mb-2 flex-wrap">
    <img
      src={localMeImage}
      alt={author}
      class="profile-image border w-8 h-8"
    />
    <strong>{author}</strong>
  </div>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-2">
      {tags.map(slug => (
        <Link
          href={`/blog/tags/${slug}`}
          class="bg-bg px-2 py-0.5 rounded border border-accent/30 text-accent text-xs hover:bg-surface/70 transition inline-block max-w-full truncate"
        >
          #{tagNames.get(slug)}
        </Link>
      ))}
    </div>
  )}

  <!-- Series -->
  {series && seriesEntry && (
    <div>
      Part of the series:&nbsp;
      <Link href={`/blog/series/${series}`}>
        {seriesEntry.data.name}
      </Link>
    </div>
  )}
</section>
