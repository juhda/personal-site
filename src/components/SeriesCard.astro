---
import Link from './Link';

import type { Series } from "../blog/lib";
import { seriesCoverUrl } from "../blog/urls";

type Props = {
  series: Series;
};

const { series } = Astro.props;
const coverImage = seriesCoverUrl(series);
---
<section class="nested-card">
  <Link href={`/blog/series/${series.id}`}>
    {coverImage && (
      <div class="cover-image-container">
        <img
        src={coverImage}
        alt={series.data.name}
        />
      </div>
    )}
    <h3 class="text-center">{series.data.name}</h3>
  </Link>
</section>
