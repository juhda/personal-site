---
import type { Series } from '../blog/lib';
import SeriesCard from './SeriesCard.astro';

interface Props {
  allSeries: Series[];
}

const { allSeries } = Astro.props;

const columns =
  allSeries.length === 1
    ? 'grid-cols-1'
    : (allSeries.length === 2
      ? 'grid-cols-2'
      : 'sm:grid-cols-2 md:grid-cols-3');
---
<div class=`grid gap-6 w-full mx-auto items-center ${columns}`>
  {allSeries.map(series => (
    <SeriesCard series={series} />
  ))}
</div>
