---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  socialLinks,
  cleanJobTitle
} from '../config/site.ts';

import { getPageBody } from '../typst/bodies';

import { Image } from 'astro:assets';
import meImage from '../assets/me.jpg';

const title = "About | " + author + " - " + jobTitle;
const description = "Learn about " + author + "'s approach to building joint ecosystems of hardware and software. Discover his principles of shared understanding, structural integrity, and architectural clarity.";
const keywords = author + ", engineering philosophy, systems architecture, custom hardware, shared understanding, 0-to-1 phase, software engineering rigor, tech leadership";
const localImage = "/og/about.png";

// Prose comes from src/content/pages/about/index.html.typ; the profile
// photo, the hardcoded title, and the CTA rows stay here.
const About = await getPageBody("about");
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  localImage={localImage}
>
  <section class="flex-card">

    <!-- Profile Photo -->
    <div class="profile-image-floater">
        <Image
          src={meImage}
          alt="Portrait of {author}"
          width={160}
          height={160}
          loading="eager"
        />
    </div>

    <!-- Text Content -->
    <div>
      <h1>About Me</h1>
      <About />

      <h2 class="muted-top-rule">Explore My Work</h2>
      <div class="cta-buttons mt-2">
        <Link href="/portfolio">Portfolio</Link>
        <Link href="/resume" download>Download Résumé (PDF)</Link>
        <Link href="/resume-overview">Résumé Overview</Link>
      </div>

      <h2>Let's Connect</h2>
      <div class="cta-buttons mt-2">
        <Link href={socialLinks.email}>Email</Link>
        <Link href={socialLinks.linkedin}>LinkedIn</Link>
      </div>
    </div>
  </section>
</BaseLayout>
