---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostMetaBox from '../../components/PostMetaBox.astro';
import CodeblockEnhancer from '../../components/CodeblockEnhancer.astro';
import Link from '../../components/Link';

import { getPost, getPostBody, getSeriesBySlug, getSeriesPosts, getSearchEnabled, getTagNames } from '../../blog/lib';

import { author, blogOGImage, blogSubscribeAction, socialLinks } from '../../config/site';
import { getStaticPaths_blog } from '../../utils/getStaticPaths';
import { postCoverUrl, postOgUrl } from '../../blog/urls';

// Generate static paths for all posts
export const getStaticPaths = getStaticPaths_blog;

const { slug } = Astro.params;

// /blog/<slug> serves published posts only; drafts are previewed at
// /blog/drafts/<id>. Params come from getStaticPaths (getPublishedPosts),
// so drafts and unknown slugs never reach this component — they are 404s
// before it runs, in builds and dev alike.
const post = (await getPost(slug!))!;
const Body = await getPostBody(post.id);
const seriesEntry = post.data.series ? await getSeriesBySlug(post.data.series) : undefined;
const seriesPosts = post.data.series ? await getSeriesPosts(post.data.series) : null;
const searchEnabled = await getSearchEnabled();

const title = (post.data.seoTitle ?? post.data.title) + " by " + author;
const description = post.data.description;
const tagNames = await getTagNames();
const keywords = "defined behavior, " + post.data.tags.map(slug => tagNames.get(slug)).join(', ');
const image = postOgUrl(post) ?? blogOGImage;
const coverImage = postCoverUrl(post) ?? postOgUrl(post) ?? blogOGImage;
const datePublished = post.data.publishedAt;
---
<BlogLayout
  title={title}
  description={description}
  keywords={keywords}
  type="article"
  headline={post.data.seoTitle ?? post.data.title}
  datePublished={datePublished}
  image={image}
  showCover={true}
  coverImage={coverImage}
  coverTitle={post.data.title}
  coverDescription={post.data.subtitle}
  showNavLinks={false}
>

  <Fragment slot="head">
    <CodeblockEnhancer />
  </Fragment>

  <div slot="blog-header">
    <PostMetaBox post={post} />
  </div>

  {Body ? (
    <article class="max-w-none px-4 md:px-6 lg:px-8 py-8">
      <Body />
    </article>
  ) : null}

  <section slot="blog-footer">
      {seriesEntry && seriesPosts ? (
        <div class="flex-card flex-col m-4 p-4 gap-2 items-center">
          <p class="font-semibold">Part of the series: <Link href={`/blog/series/${seriesEntry.id}`}>{seriesEntry.data.name}</Link></p>
          <ul>
            {seriesPosts.map((s, idx) => {
              const currentIdx = seriesPosts.findIndex(p => p.id === post.id);
              return (
                <li>
                  {idx === currentIdx ? (
                    <span>{s.data.title} (Current)</span>
                  ) : (
                    <Link href={`/blog/${s.id}`} visited={idx < currentIdx}>{s.data.title}</Link>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ) : null}
      <p class="text-center">
        👉 <strong>Explore more:</strong>{' '}
        <Link href="/blog/tags">Browse by Tags</Link>,{' '}
        <Link href="/blog/series">Explore Series</Link>,{' '}
        <Link href="/blog/archives">Browse Archives</Link>
        {searchEnabled && <Fragment>, <Link href="/blog/search">Search the Blog</Link></Fragment>}
      </p>

      <p class="text-center">
        💬 <strong>Have thoughts or questions?</strong>{' '}
        Feel free to <Link href={socialLinks.email}>reach out by email</Link> or{' '}
        <Link href={socialLinks.linkedin}>connect on LinkedIn</Link>.
      </p>

      {blogSubscribeAction && (
        <p class="text-center">
          ✉️ <strong>Enjoyed this post?</strong>{' '}
          <Link href="/blog/subscribe">Subscribe</Link> to get new articles straight to your inbox.
        </p>
      )}
    </section>
</BlogLayout>
