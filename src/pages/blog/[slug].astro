---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostMetaBox from '../../components/PostMetaBox.astro';
import MathJaxLoader from '../../components/MathJaxLoader.astro';
import HighlightJSLoader from '../../components/HighlightJSLoader.astro';
import CodeblockEnhancer from '../../components/CodeblockEnhancer.astro';
import Link from '../../components/Link';
import HashnodeError from '../../components/HashnodeError.astro';

import { getPost, getBlogInfo, isSearchEnabled, getSeries } from '../../hashnode-lib/client';
import type { BlogInfo, Post, Series } from '../../hashnode-lib/schema';

import { blogSubscribeAction, socialLinks } from '../../config/site';
import { getStaticPaths_blog } from '../../utils/getStaticPaths';

export const prerender = false

// Generate static paths for all posts in case of prerender=true
export const getStaticPaths = getStaticPaths_blog;

const { slug } = Astro.params;
let blogInfo: BlogInfo | null = null;
let post: Post | null = null;
let series: Series | null = null;
let error: string | null = null;

try {
  blogInfo = await getBlogInfo();
  post = await getPost(slug);
  if (post?.series?.slug) {
    series = await getSeries(post.series.slug);
  }
} catch (e: unknown) {
  error = (e instanceof Error ? e.message : String(e)) || 'Unknown error occurred while fetching blog data.';
}

if (!error && !post) {
  return Astro.redirect("/404")
}

const title = post ? ((post.seo?.title ?? post.title) + " by " + post.author.name) : "Post Not Found";
const description = post ? (post.seo?.description ?? post.brief) : "";
const keywords = post ? ("defined behavior, " + post.tags.map(tag => tag.name).join(', ')) : "";
const canonical = post?.canonicalUrl;
const image = post?.ogMetaData?.image ?? blogInfo?.ogMetaData?.image;
const coverImage = post?.coverImage?.url ?? post?.ogMetaData?.image ?? blogInfo?.ogMetaData?.image;
const content = post?.content?.html ?? "-Empty content-";
---
<BlogLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  type={post ? "article" : null}
  headline={post?.seo?.title ?? post?.title}
  datePublished={post?.publishedAt}
  image={image}
  showCover={Boolean(post)}
  coverImage={coverImage}
  coverTitle={post?.title}
  coverDescription={post?.subtitle}
  sourceNoteUsername={post?.author.username ?? blogInfo?.author.username}
  showNavLinks={false}
>

  <Fragment slot="head">
    <MathJaxLoader content={content} />
    <HighlightJSLoader content={content} />
    <CodeblockEnhancer />
  </Fragment>

  {error ? (
    <HashnodeError error={error} />
  ) : null}

  {!error && post ? (
    <div slot="blog-header">
      <PostMetaBox post={post} />
    </div>
  ) : null}

  {!error && post ? (
    <article class="max-w-none px-4 md:px-6 lg:px-8 py-8">
      <div set:html={content} />
    </article>
  ) : null}

  {!error && post ? (
    <section slot="blog-footer">
      {series ? (
        <div class="flex-card flex-col m-4 p-4 gap-2 items-center">
          <p class="font-semibold">Part of the series: <Link href={`/blog/series/${series.slug}`}>{series.name}</Link></p>
          <ul>
            {(() => {
              const currentIdx = series.posts.findIndex(p => p.slug === post?.slug);
              return series.posts.map((s, idx) => (
                <li>
                  {idx === currentIdx ? (
                    <span>{s.title} (Current)</span>
                  ) : (
                    <Link href={`/blog/${s.slug}`} visited={idx < currentIdx}>{s.title}</Link>
                  )}
                </li>
              ));
            })()}
          </ul>
        </div>
      ) : null}
      <p class="text-center">👉 <strong>Explore more:</strong>
        <Link href="/blog/tags">Browse by Tags</Link>,
        <Link href="/blog/series">Explore Series</Link>,
        <Link href="/blog/archives">Browse Archives</Link>{isSearchEnabled && ","}
        {isSearchEnabled && (
          <Link href="/blog/search">Search the Blog</Link>
        )}
      </p>

      <p class="text-center">💬 <strong>Have thoughts or questions?</strong>
        Feel free to <Link href={socialLinks.email}>reach out by email</Link> or
        <Link href={socialLinks.linkedin}>connect on LinkedIn</Link>.
      </p>

      {blogSubscribeAction && (
        <p class="text-center">✉️ <strong>Enjoyed this post?</strong>
          <Link href="/blog/subscribe">Subscribe</Link> to get new articles straight to your inbox.
        </p>
      )}
    </section>
  ) : null}
</BlogLayout>
