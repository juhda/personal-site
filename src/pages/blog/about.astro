---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Link from '../../components/Link';

import { getSearchEnabled } from '../../blog/lib';

import { author, blogDescriptionSEO, blogOGImage, blogSubscribeAction, blogTitle, localMeImage, socialLinks } from '../../config/site';

const searchEnabled = await getSearchEnabled();

const description = "The philosophy behind Defined Behavior: A space for engineering thoughtfulness in the development of complex systems, from hardware to human collaboration.";
const keywords = "about blog, defined behavior philosophy, systems thinking, engineering precision, structural integrity, custom hardware";
const coverImage = blogOGImage;
---
<BlogLayout
  title={`About | ${blogTitle} by ${author}`}
  description={description}
  keywords={keywords}
  coverImage={coverImage}
  coverTitle={`About ${blogTitle}`}
  coverDescription={blogDescriptionSEO}
>
  <section class="card">
    <!-- Author info -->
    <div class="flex items-center justify-center gap-4 mb-6 text-center">
      <img
        src={localMeImage}
        alt={author}
        class="profile-image border w-16 h-16"
      />
      <div class="flex flex-col justify-center items-center">
        <h2 class="mt-0 mb-0">{author}</h2>
      </div>
    </div>

    <!-- Custom about text -->
    <div class="muted-top-rule">
      <p>
        <strong>Defined Behavior</strong> is a space for engineering thoughtfulness in the development of complex systems.
      </p>

      <p>
        Authored by {author}, this blog explores the intersection of hardware, software, and human systems. Whether diving into tooling, architecture, or the nuances of technical leadership, this is a place for structured insight, developer empowerment, and systems-level thinking.
      </p>

      <h2>The Philosophy</h2>

      <p>
        The name "Defined Behavior" stands in contrast to undefined behavior — not just in code, but in thought and communication. It is a statement of principle: that <strong>clarity is a choice, precision is a discipline, and complexity deserves structure, not surrender.</strong>
      </p>

      <p>
        In the <strong>"0 to 1" phase</strong> of deep-tech engineering, ambiguity is the default. This blog exists to explore how we move from that chaos toward a unified ecosystem of hardware and software, built on a foundation of shared understanding.
      </p>

      <h2>A Deliberate Pace</h2>
      {!searchEnabled && (
        <p>
          If the archive is still light, that is by design. I focus on thinking and publishing deliberately, not frequently. Defined Behavior will grow over time with writing that reflects its core principles: clarity, structure, and purpose.
        </p>
      )}
      {searchEnabled && (
        <p>
          I focus on depth over frequency. This archive is built deliberately, with each piece reflecting a commitment to clarity and structural integrity. I write when there is a complex system to deconstruct or a meaningful insight to share, ensuring every post serves a purpose for the reader.
        </p>
      )}
    </div>
  </section>

  <section class="card mt-8">
    <h2>How to Follow This Blog</h2>
    <p>
      If you'd like to stay updated when I publish new posts on compilers, systems, developer tools, or technical leadership:
      <ul>
        {blogSubscribeAction && (
          <li>✉️ <strong><Link href="/blog/subscribe">Subscribe by email</Link></strong> — Get new posts delivered straight to your inbox.</li>
        )}
        <li>📡 <strong><Link href="/blog/rss.xml">Subscribe via RSS</Link></strong> — Get updates in your feed reader.</li>
      </ul>
    </p>
    <p>
      You can also follow me on <Link href={socialLinks.linkedin}>LinkedIn</Link>, where I share updates and discuss new articles.
    </p>
  </section>
</BlogLayout>
