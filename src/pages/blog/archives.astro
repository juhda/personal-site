---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostGallery from '../../components/PostGallery';
import EmptyState from '../../components/EmptyState';

import { getPublishedPosts, type Post, getTagNameMap } from '../../blog/lib';

import { author, blogTitle } from '../../config/site';

const allPosts = await getPublishedPosts();
const tagNames = await getTagNameMap();

// Group posts by publication year; posts without a publication date (e.g.
// uncommitted drafts in dev/preview) have no year to be filed under.
function groupPostsByYear(posts: Post[]): Record<number, Post[]> {
  return posts.reduce((acc, post) => {
    const { publishedAt } = post.data;
    if (!publishedAt) return acc;
    const year = new Date(publishedAt).getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  }, {} as Record<number, Post[]>);
}

const postsByYear = groupPostsByYear(allPosts);

// Sort years descending
const sortedYears = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);

const title = `Blog Archives | ${blogTitle} by ${author}`;
const description = "Browse all published posts, grouped by year.";
const keywords = "blog archives, defined behavior, hardware-software co-design, compilers, systems architecture, technical leadership, engineering principles, deep-tech strategy";
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showCover={false}
>
  <div slot="blog-header" class="card">
    <h1 class="text-center">Blog Archives</h1>
    <p class="text-center">
      Browse all published posts, grouped by year.
    </p>
  </div>

  {sortedYears.length > 0 ? (
    sortedYears.map(year => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-4 muted-bottom-rule pb-1">{year}</h2>
        <PostGallery posts={postsByYear[year]} tagNames={tagNames} />
      </section>
    ))
  ) : (
    <EmptyState
      title="No posts yet"
      message="Once posts are published, they'll appear here by year."
    />
  )}
</BlogLayout>
