---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostMetaBox from '../../../components/PostMetaBox.astro';
import MathJaxLoader from '../../../components/MathJaxLoader.astro';
import HighlightJSLoader from '../../../components/HighlightJSLoader.astro';
import CodeblockEnhancer from '../../../components/CodeblockEnhancer.astro';
import HashnodeError from '../../../components/HashnodeError.astro';

import { getDraft, getBlogInfo } from '../../../hashnode-lib/client';
import type { BlogInfo, Draft } from '../../../hashnode-lib/schema';

import { blogEnableDrafts } from '../../../config/site';
import { getStaticPaths_blog_drafts } from '../../../utils/getStaticPaths';

export const prerender = false

// Generate static paths for all posts in case of prerender=true
export const getStaticPaths = getStaticPaths_blog_drafts;

if (!blogEnableDrafts) {
  return Astro.redirect("/404");
}

const { id } = Astro.params;
let blogInfo: BlogInfo | null = null;
let post: Draft | null = null;
let error: string | null = null;

try {
  blogInfo = await getBlogInfo();
  post = await getDraft(id);
} catch (e: unknown) {
  error = (e instanceof Error ? e.message : String(e)) || 'Unknown error occurred while fetching blog data.';
}

if (!error && !post) {
  return Astro.redirect("/404");
}

const postTitle = post?.title || "-Untitled-";
const title = post ? (postTitle + " (Draft) by " + post.author.name) : "Draft Post";
const coverImage = post?.coverImage?.url ?? blogInfo?.ogMetaData?.image;
const content = post?.content?.html ?? "-Empty draft content-";
---
<BlogLayout
  title={title}
  showCover={Boolean(post)}
  coverImage={coverImage}
  coverTitle={postTitle}
  coverDescription={post?.subtitle}
  sourceNoteUsername={post?.author.username}
  showNavLinks={false}
>

  {error ? (
    <HashnodeError error={error} />
  ) : post && (
    <>
      <Fragment slot="head">
        <MathJaxLoader content={content} />
        <HighlightJSLoader content={content} />
        <CodeblockEnhancer />
      </Fragment>

      <!-- Post information -->
      <div slot="blog-header">
        <PostMetaBox post={post} />
      </div>

      <!-- Rendered blog content -->
      <article class="max-w-none px-4 md:px-6 lg:px-8 py-8">
        <div set:html={content} />
      </article>
    </>
  )}
</BlogLayout>
