---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostGallery from '../../../components/PostGallery';
import EmptyState from '../../../components/EmptyState';

import { getDraftPosts, getTagNameMap } from '../../../blog/lib';

import { blogTitle } from '../../../config/site';
import { getStaticPaths_blog_drafts } from '../../../utils/getStaticPaths';

// Draft pages only exist in dev / branch preview contexts; generate them only
// when drafts are visible there (an empty path list renders the route a 404).
export const getStaticPaths = getStaticPaths_blog_drafts;

const drafts = await getDraftPosts();
const tagNames = await getTagNameMap();

const title = `Draft Posts | ${blogTitle}`;
---
<BlogLayout
  noindex={true}
  title={title}
  showCover={false}
>
  <div slot="blog-header" class="card">
    <h1 class="text-center">Draft Posts</h1>
    <p class="text-center">
      Browse all draft posts.
    </p>
  </div>

  {drafts.length > 0 ? (
    <PostGallery posts={drafts} tagNames={tagNames} />
  ) : (
    <EmptyState
      title="No drafts yet"
      message="Draft posts will appear here once created."
    />
  )}
</BlogLayout>
