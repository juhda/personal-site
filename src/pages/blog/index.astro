---
import BlogLayout from '../../layouts/BlogLayout.astro';
import MathJaxLoader from '../../components/MathJaxLoader.astro';
import HighlightJSLoader from '../../components/HighlightJSLoader.astro';
import PostGallery from '../../components/PostGallery';
import PostCard from '../../components/PostCard';
import EmptyState from '../../components/EmptyState';
import Link from '../../components/Link';
import HashnodeError from '../../components/HashnodeError.astro';

import { getBlogInfo, getPinnedPostInfo, getRecentPostInfo } from '../../hashnode-lib/client';
import type { BlogInfo, PostInfo } from '../../hashnode-lib/schema';

import { blogNumRecentPosts, blogOGImage, blogSubscribeAction } from '../../config/site';

export const prerender = false

let blogInfo: BlogInfo | null = null;
let pinnedPostInfo: PostInfo | null = null;
let recentPostInfo: PostInfo[] = [];
let error: string | null = null;

try {
  blogInfo = await getBlogInfo();
  pinnedPostInfo = await getPinnedPostInfo();
  recentPostInfo = await getRecentPostInfo(blogNumRecentPosts);
} catch (e: unknown) {
  error = (e instanceof Error ? e.message : String(e)) || 'Unknown error occurred while fetching blog data.';
}

const title = blogInfo ? (blogInfo.displayTitle ?? (blogInfo.title + " by " + blogInfo.author.name)) : "Blog";
const description = blogInfo ? ("Welcome to " + blogInfo.title + " — a blog by " + blogInfo.author.name + "exploring the hardware-software bridge, compilers, and technical leadership with clarity and purpose.") : "Blog posts";
const keywords = blogInfo ? ("defined behavior, " + blogInfo.author.name + " blog, systems thinking, compiler development, engineering leadership, hardware-software co-design, technical precision, deep-tech strategy") : "blog";
const image = blogInfo?.ogMetaData?.image;
const coverImage = image ?? blogOGImage;
---
<BlogLayout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  coverImage={coverImage}
  coverTitle={blogInfo?.title}
  coverDescription={blogInfo?.descriptionSEO}
  sourceNoteUsername={blogInfo?.author.username}
>
  <Fragment slot="head">
    <MathJaxLoader content={pinnedPostInfo?.brief + recentPostInfo.map(postInfo => postInfo.brief).join('\n')} />
    <HighlightJSLoader content={pinnedPostInfo?.brief + recentPostInfo.map(postInfo => postInfo.brief).join('\n')} />
  </Fragment>

  {error ? (
    <HashnodeError error={error} />
  ) : null}

  {!error && pinnedPostInfo ? (
    <section class="card mb-8">
      <h2>Featured Post</h2>
      <PostCard postInfo={pinnedPostInfo} />
    </section>
  ) : null}

  {!error ? (
    <section class="card">
      {recentPostInfo.length > 0 ? (
        <>
          <h2>Recent Posts</h2>
          <PostGallery allPostInfo={recentPostInfo} />
        </>
      ) : (
        <EmptyState
          title="No posts yet"
          message="New content is coming soon — stay tuned!"
          ctaText={blogSubscribeAction ? "Subscribe" : undefined}
          ctaHref={blogSubscribeAction ? "/blog/subscribe" : undefined}
        />
      )}
    </section>
  ) : null}

  <section slot="blog-footer">
    <ul class="list-none">
      <li class="muted-note">✉️ Prefer email? <Link href="/blog/subscribe">Subscribe</Link> to get updates in your inbox.</li>
      <li class="muted-note">📡 Prefer RSS? You can follow new posts via <Link href="/blog/rss.xml">/blog/rss.xml</Link>.</li>
    </ul>
  </section>
</BlogLayout>
