---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostGallery from '../../components/PostGallery';
import EmptyState from '../../components/EmptyState';
import Link from '../../components/Link';

import { getPublishedPosts, getTagNameMap } from '../../blog/lib';

import { author, blogDescriptionSEO, blogNumRecentPosts, blogOGImage, blogSubscribeAction, blogTitle } from '../../config/site';

const posts = await getPublishedPosts();
const tagNames = await getTagNameMap();
const recentPosts = posts.slice(0, blogNumRecentPosts);

const title = `${blogTitle} by ${author}`;
const description = blogDescriptionSEO;
const keywords = "defined behavior, " + author + " blog, systems thinking, compiler development, engineering leadership, hardware-software co-design, technical precision, deep-tech strategy";
---
<BlogLayout
  title={title}
  description={description}
  keywords={keywords}
  coverImage={blogOGImage}
  coverTitle={/* Skip coverTitle as coverImage contains the blog title */ null}
  coverDescription={blogDescriptionSEO}
>

  <section class="card">
    {recentPosts.length > 0 ? (
      <>
        <h2>Recent Posts</h2>
        <PostGallery posts={recentPosts} tagNames={tagNames} />
      </>
    ) : (
      <EmptyState
        title="No posts yet"
        message="New content is coming soon — stay tuned!"
        ctaText={blogSubscribeAction ? "Subscribe" : undefined}
        ctaHref={blogSubscribeAction ? "/blog/subscribe" : undefined}
      />
    )}
  </section>

  <section slot="blog-footer">
    <ul class="list-none">
      <li class="muted-note">✉️ Prefer email? <Link href="/blog/subscribe">Subscribe</Link> to get updates in your inbox.</li>
      <li class="muted-note">📡 Prefer RSS? You can follow new posts via <Link href="/blog/rss.xml">/blog/rss.xml</Link>.</li>
    </ul>
  </section>
</BlogLayout>
