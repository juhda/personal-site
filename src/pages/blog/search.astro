---
import BlogLayout from '../../layouts/BlogLayout.astro';
import SearchResults from '../../components/SearchResults';

import { getPublishedPosts, getTagNameMap } from '../../blog/lib';

import { author, blogTitle } from '../../config/site';

const allPosts = await getPublishedPosts();
const tagNames = await getTagNameMap();

const title = `Search | ${blogTitle} by ${author}`;
const description = `Search ${blogTitle} for deep-dives into systems architecture, compilers, and the hardware-software bridge.`;
const keywords = "search blog, defined behavior, hardware-software co-design, systems thinking, engineering precision, technical leadership, deep-tech strategy, RISC-V, LLVM";
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showCover={false}
>
  <div slot="blog-header">
    <label for="search-input">
      Search blog posts
    </label>
    <input
      id="search-input"
      type="search"
      placeholder="Keywords or tags..."
    />
  </div>

  <SearchResults client:load posts={allPosts} tagNames={tagNames} search_input={"search-input"} />
</BlogLayout>
