---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostGallery from '../../../components/PostGallery';
import EmptyState from '../../../components/EmptyState';
import Link from '../../../components/Link';

import { getSeriesBySlug, getSeriesPosts, getSearchEnabled, getTagNameMap } from '../../../blog/lib';
import { seriesCoverUrl } from '../../../blog/urls';

import { blogOGImage, blogSubscribeAction, blogTitle } from '../../../config/site';
import { getStaticPaths_blog_series } from '../../../utils/getStaticPaths';

// Generate static paths for all series
export const getStaticPaths = getStaticPaths_blog_series;

const { series_name } = Astro.params;

const series = await getSeriesBySlug(series_name!);
const seriesPosts = series ? await getSeriesPosts(series.id) : [];
const searchEnabled = await getSearchEnabled();
const tagNames = await getTagNameMap();

const title = series ? `Posts in ${series.data.name} | ${blogTitle}` : "Blog Series";
const description = series ? `Explore the ${series.data.name} series on ${blogTitle} — a deep dive into systems architecture, engineering precision, and custom hardware platforms.` : "";
const keywords = series ? (series.data.name + ", blog series, defined behavior, systems thinking, compiler development, engineering leadership, hardware-software co-design, technical precision, deep-tech strategy") : "";
const coverImage = series ? (seriesCoverUrl(series) ?? blogOGImage) : null;
---
<BlogLayout
  title={title}
  description={description}
  keywords={keywords}
  showCover={Boolean(series)}
  coverImage={coverImage}
  coverTitle={series?.data.name}
  coverDescription={series?.data.description}
>
  {series ? (
    seriesPosts.length > 0 ? (
      <PostGallery posts={seriesPosts} tagNames={tagNames} />
    ) : (
      <EmptyState
        icon="📕"
        title="No posts in this series yet"
        message="This series has been defined but doesn't contain any published posts yet."
      />
    )
  ) : null}

  {series ? (
    <section slot="blog-footer">
      {blogSubscribeAction && (
        <p>
          ✉️ <strong>Enjoying this series?</strong>{' '}
          <Link href="/blog/subscribe">Subscribe</Link> to get future posts on this and related topics.
        </p>
      )}

      <p class="text-center">
        👉 <strong>{blogSubscribeAction ? "Or e" : "E"}xplore more:</strong>{' '}
        <Link href="/blog/series">Other Series</Link>,{' '}
        <Link href="/blog/tags">Browse Tags</Link>
        {searchEnabled && <Fragment>, <Link href="/blog/search">Search the Blog</Link></Fragment>}
      </p>
    </section>
  ) : null}
</BlogLayout>
