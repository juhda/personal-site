---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import SeriesGallery from '../../../components/SeriesGallery.astro';
import EmptyState from '../../../components/EmptyState';

import { getSeries } from '../../../blog/lib';

import { author, blogTitle } from '../../../config/site';

const seriesList = await getSeries();

const title = `Blog Series | ${blogTitle} by ${author}`;
const description = "Explore multi-part article series on " + blogTitle + ". A deep dive into the 0-to-1 phase of compilers, systems architecture, and the human side of technical leadership.";
const keywords = "blog series, defined behavior, hardware-software co-design, compilers, systems architecture, technical leadership, engineering principles, deep-tech strategy";
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showCover={false}
>
  {seriesList.length > 0 ? (
    <div slot="blog-header">
      <h1 class="text-center">Browse Series</h1>
    </div>

    <SeriesGallery allSeries={seriesList} />
  ) : (
    <EmptyState
      icon="📚"
      title="No series yet"
      message="Once a series is created, it will appear here."
    />
  )}
</BlogLayout>
