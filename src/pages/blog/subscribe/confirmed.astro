---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Link from '../../../components/Link';

import { author, blogTitle } from '../../../config/site';

const title = "You’re Subscribed | " + blogTitle + " by " + author;
const description = "Welcome to " + blogTitle + ". You are now set to receive deliberate, high-signal updates on systems, architecture, and the hardware-software bridge from " + author + ".";
const keywords = "subscription confirmed, defined behavior, systems thinking, technical leadership, deep-tech strategy, hardware-software co-design, engineering rigor";
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showCover={false}
  showSourceNote={false}
>
  <section class="card text-center">
    <div class="text-4xl mb-4">🎉</div>
    <h2 class="text-center"> You’re subscribed!</em></h2>
    <p class="text-center">
      From now on, you’ll get a short email from me whenever I publish a new post.
      <br />Thanks for joining — I appreciate your time and attention.
    </p>
    <Link href="/blog" class="cta-button">
      Start exploring the blog
    </Link>
  </section>
</BlogLayout>
