---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Link from '../../../components/Link';

import { author, blogTitle } from '../../../config/site';

const title = "Confirm Your Subscription | " + blogTitle + " by " + author;
const description = "One last step to join " + blogTitle + ". Please confirm your email to receive structured insights on systems engineering and technical leadership.";
const keywords = "confirm subscription, defined behavior, newsletter, systems engineering, engineering principles, technical leadership, deep-tech strategy";
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showBanner={false}
  showSourceNote={false}
>
  <section class="card text-center">
    <div class="text-4xl mb-4">✅</div>
    <h2 class="text-center">Thanks for subscribing!</h2>
    <h2 class="text-center">📩 One last step:</h2>
    <p class="text-center">
      Please check your inbox and click the confirmation link to complete your subscription to <em>{blogTitle}</em>.
      <br />I only send brief notes when new posts go live — no noise, just structured insight.
    </p>
    <Link href="/blog" class="muted-top-rule pt-0 py-8">
      Browse the latest posts while you wait
    </Link>
  </section>
</BlogLayout>
