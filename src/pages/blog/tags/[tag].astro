---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostGallery from '../../../components/PostGallery';
import EmptyState from '../../../components/EmptyState';
import Link from '../../../components/Link';

import { getTaggedPosts, getSearchEnabled, getTagNameMap } from '../../../blog/lib';

import { blogSubscribeAction, blogTitle } from '../../../config/site';
import { getStaticPaths_blog_tags } from '../../../utils/getStaticPaths';

// Generate static paths for all tags
export const getStaticPaths = getStaticPaths_blog_tags;

const { tag } = Astro.params;

const allPosts = await getTaggedPosts(tag!);
const tagNames = await getTagNameMap();
const searchEnabled = await getSearchEnabled();

const postCount = allPosts.length;
// tagNames is complete by construction (see getTagNames), so the current
// tag always resolves.
const tagLabel = tagNames[tag!];

const title = `Posts tagged #${tagLabel} | ${blogTitle}`;
const description = `Explore blog posts tagged with #${tagLabel} on ${blogTitle} — exploring systems, architecture, and engineering discipline.`;
const keywords = `${tagLabel}, defined behavior, systems thinking, compiler development, engineering leadership, hardware-software co-design, technical precision, deep-tech strategy`;
---
<BlogLayout
  noindex={true}
  title={title}
  description={description}
  keywords={keywords}
  showCover={false}
>
  <div slot="blog-header">
    <h1 class="text-center">Posts tagged #{tagLabel}</h1>
  </div>

  {postCount > 0 ? (
    <PostGallery posts={allPosts} tagNames={tagNames} />
  ) : (
    <EmptyState
      icon="🔖"
      title={`No posts tagged #${tagLabel}`}
      message="Try another tag or check back later!"
    />
  )}

  <section slot="blog-footer">
    <p class="text-center">👉 <strong>Looking for more?</strong>
      <Link href="/blog/tags">Browse all Tags</Link>,
      <Link href="/blog/series">Explore Series</Link>{searchEnabled && ","}
      {searchEnabled && (
        <Link href="/blog/search">Search the Blog</Link>
      )}
    </p>

    {blogSubscribeAction && (
      <p>✉️ <strong>Like content like this?</strong>
        <Link href="/blog/subscribe">Subscribe</Link> to get future posts on this and related topics.
      </p>
    )}
  </section>
</BlogLayout>
