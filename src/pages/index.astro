---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  cleanJobTitle
} from '../config/site.ts';

import { Image } from 'astro:assets';
import meImage from '../assets/me.jpg';

const title = author + " - " + jobTitle;
const description = "The personal website of " + author + ", a " + cleanJobTitle + " specializing in the hardware-software bridge. Exploring the 0-to-1 phase of compilers, systems architecture, and co-design.";
const keywords = author + ", systems engineer, software engineer, hardware-software co-design, compiler development, RISC-V, system simulation, 0-to-1 engineering, technical leadership, portfolio, blog";
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <section class="flex-card">

    <!-- Profile Photo -->
    <div class="profile-image-floater">
      <Image
        src={meImage}
        alt="Portrait of {author}"
        width={160}
        height={160}
        loading="eager"
      />
    </div>

    <!-- Text Content -->
    <div>
      <h1>👋 Welcome  —  I'm <span class="whitespace-nowrap">{author}</span></h1>
      <h2 class="text-text font-medium">{jobTitle}</h2>
      <p class="italic text-primary">
        Building the Hardware-Software Bridge
      </p>
      <p>
        I am a software engineer focused on <strong>Hardware-Software Co-Design</strong>. I build the infrastructure — specifically <em>compilers, simulators, and co-design frameworks</em> — that allows silicon and code to evolve as a <strong>joint ecosystem</strong>.
      </p>
      <p>
        I specialize in the <strong>"0 to 1" phase</strong> of deep-tech systems, bringing modern software engineering rigor to RISC-V platforms and resource-constrained environments. I thrive on turning architectural constraints into opportunities for system-level clarity.
      </p>
      <p>
        This site is a space for me to share my work and ideas in public. On my <Link href="/blog">blog</Link>, I write about the intersection of technology and human systems — from technical deep-dives into <strong>embedded systems and toolchain development</strong> to broader insights on <strong>software engineering and tech leadership</strong>.
      </p>
      <p>
        My goal is to build a <strong>shared understanding</strong> across disciplines, enabling teams to move forward with clarity and purpose. If this approach to engineering resonates with you, I invite you to explore my work or reach out for a conversation.
      </p>

      <!-- Call-to-Action Buttons -->
      <div class="cta-buttons">
        <Link href="/about">About Me</Link>
        <Link href="/portfolio">View Portfolio</Link>
        <Link href="/blog">Read Blog</Link>
      </div>
    </div>
  </section>
</BaseLayout>
