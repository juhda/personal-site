---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  cleanJobTitle
} from '../config/site.ts';

import { Image } from 'astro:assets';
import meImage from '../assets/me.jpg';

const title = author + " - " + jobTitle;
const description = "The personal website of " + author + ", a " + cleanJobTitle + " specializing in the hardware-software bridge. Exploring the 0-to-1 phase of compilers, systems architecture, and co-design.";
const keywords = author + ", systems engineer, software engineer, hardware-software co-design, compiler development, RISC-V, system simulation, 0-to-1 engineering, technical leadership, portfolio, blog";
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <section class="flex-card">

    <!-- Profile Photo -->
    <div class="profile-image-floater">
      <Image
        src={meImage}
        alt="Portrait of {author}"
        width={160}
        height={160}
        loading="eager"
      />
    </div>

    <!-- Text Content -->
    <div>
      <h1>👋 Welcome — I'm <span class="whitespace-nowrap">{author}</span></h1>
      <h2 class="text-text font-medium">{jobTitle} | Hardware-Software Co-Design</h2>
      <p>
        I empower teams to bridge the gap between hardware and software through <em>structured insight, developer empowerment, and systems-level thinking</em>. My work centers on <strong>Hardware-Software Co-Design</strong>, where I develop system-level solutions and the infrastructure — <em>compilers, simulators, and frameworks</em> — that enables silicon and software to evolve as a unified ecosystem.
      </p>
      <p>
        I specialize in the <strong>"0 to 1" phase</strong> of deep-tech systems, applying modern software engineering rigor to <em>resource-constrained environments</em> and platforms like <strong>RISC-V</strong>. By turning architectural constraints into opportunities, I help teams establish clarity and alignment from the ground up.
      </p>
      <p>
        This site is a space for me to share my work and ideas publicly. On my <Link href="/blog">blog</Link>, I explore the intersection of technology and human systems — from technical deep-dives into <strong>embedded systems and toolchain development</strong> to broader reflections on <strong>engineering efficiency and leadership</strong>.
      </p>
      <p>
        My goal is to foster <strong>shared understanding</strong> across disciplines, enabling teams to collaborate with purpose and precision. If this approach resonates with you, I invite you to explore my work or reach out for a conversation.
      </p>

      <!-- Call-to-Action Buttons -->
      <div class="cta-buttons">
        <Link href="/about">About Me</Link>
        <Link href="/portfolio">View Portfolio</Link>
        <Link href="/blog">Read Blog</Link>
      </div>
    </div>
  </section>
</BaseLayout>
