---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  cleanJobTitle
} from '../config/site.ts';

import { Image } from 'astro:assets';
import meImage from '../assets/me.jpg';

const title = author + " - " + jobTitle;
const description = "The personal website of " + author + ", a " + cleanJobTitle + " building the software that makes custom hardware usable — compilers, simulators, and embedded firmware, from the 0-to-1 phase.";
const keywords = author + ", software consultant, systems engineer, software engineer, hardware-software co-design, compiler development, RISC-V, system simulation, 0-to-1 engineering, technical leadership, portfolio, blog";
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <section class="flex-card">

    <!-- Profile Photo -->
    <div class="profile-image-floater">
      <Image
        src={meImage}
        alt="Portrait of {author}"
        width={160}
        height={160}
        loading="eager"
      />
    </div>

    <!-- Text Content -->
    <div>
      <h1>👋 Welcome — I'm <span class="whitespace-nowrap">{author}</span></h1>
      <h2 class="text-text font-medium">{jobTitle} | Software Platforms for Custom Hardware</h2>
      <p>
        I build the software that makes custom hardware usable: compilers, simulators, and embedded firmware — the core system layers that translate hardware constraints into reliable, high-performance platforms. That work often starts in co-design with hardware teams, because the decisions made there determine what the platform can become.
      </p>
      <p>
        I specialize in the <strong>"0 to 1" phase</strong> of deep-tech systems, applying modern software engineering rigor to resource-constrained environments and platforms like RISC-V. By turning architectural constraints into opportunities, I help teams establish clarity and alignment from the ground up.
      </p>
      <p>
        The results of this approach are concrete: I led a custom edge AI accelerator from architecture study through toolchain and runtime to RISC-V SoC integration, and I currently enable edge AI on space-grade compute with Frontgrade Gaisler.
      </p>
      <p>
        This site is a space for me to share my work and ideas publicly. On my <Link href="/blog">blog</Link>, I explore the intersection of technology and human systems — from technical deep-dives into embedded systems and toolchain development to broader reflections on engineering efficiency and leadership.
      </p>
      <p>
        My goal is to foster <strong>shared understanding</strong> across disciplines, enabling teams to collaborate with purpose and precision. The work where I add the most value starts early, while hardware and software decisions still shape each other — if you are building such a platform, I would welcome the conversation about how I could contribute.
      </p>

      <!-- Call-to-Action Buttons -->
      <div class="cta-buttons">
        <Link href="/about">About Me</Link>
        <Link href="/portfolio">View Portfolio</Link>
        <Link href="/blog">Read Blog</Link>
      </div>
    </div>
  </section>
</BaseLayout>
