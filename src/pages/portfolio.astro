---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  socialLinks,
  cleanJobTitle
} from '../config/site.ts';

const title = "Project Portfolio | " + author + " - " + jobTitle;
const description = "Explore selected projects by " + author + ", focusing on compilers, simulators, and platform enablement. High-impact work in hardware-software co-design and system-level architecture.";
const keywords = "project portfolio, " + author + ", LLVM, RISC-V, system simulators, compiler design, firmware development, toolchain integration, platform architecture";
const localImage = "/og/portfolio.png";
---
<BaseLayout
  noPadding={true}
  title={title}
  description={description}
  keywords={keywords}
  localImage={localImage}
>
  <section class="card">
    <div>
      <h1>Project Portfolio</h1>

      <p>
        This portfolio is a curated look at my work in <strong>Hardware-Software Co-Design</strong>. I specialize in building the core system layers — <strong>compilers, simulators, and embedded firmware</strong> — that turn complex hardware constraints into reliable, high-performance ecosystems.
      </p>

      <p>
        I am at my best during the <strong>"0 to 1" phase</strong> of a project, where the foundation of a system is built. My contributions focus on creating <strong>shared understanding</strong> between disciplines, ensuring that silicon architecture and system software evolve together with clarity and purpose.
      </p>

      <h2>How to Navigate My Work</h2>

      <p>
        The table below provides a detailed view of my projects. Each entry is structured to highlight:
        <ul class="list-disc pl-6">
          <li><strong>The Challenge:</strong> The architectural or engineering bottleneck I was tasked to solve.</li>
          <li><strong>The Solution:</strong> My technical approach across the hardware-software stack.</li>
          <li><strong>The Impact:</strong> The resulting platform enablement, workflow efficiency, or system-level clarity.</li>
        </ul>
      </p>
      
      <p>
        You can use the predefined views to explore by domain (e.g., System Architecture, Developer Tooling) or project role (e.g., Compiler Engineer, Technical Lead).
      </p>

      <p class="muted-top-rule">
        <strong>Looking for more context?</strong> > Visit my <Link href="/about">About page</Link> to learn about my engineering philosophy, or check out my <Link href="/blog">blog</Link> for deep-dives into systems engineering and tech leadership.
      </p>

      <p>
        Feel free to <Link href={socialLinks.email}>email me</Link> or <Link href={socialLinks.linkedin}>connect on LinkedIn</Link>.
      </p>
    </div>
  </section>

  <!-- Portfolio Table Embed -->
  <div class="wide-embed">
    <iframe
      src="https://juhaszdavid.notion.site/ebd//1d07a2153eff8022ab18e7c4208be2d9?v=1d67a2153eff80c7bf68000c92ee9408"
      title={title}
      loading="eager"
      allowfullscreen
    ></iframe>
  </div>
</BaseLayout>
