---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  cleanJobTitle
} from '../config/site.ts';

import { getPageBody } from '../typst/bodies';

const title = "Résumé Overview | " + author + " - " + jobTitle;
const description = "Download or view the résumé of " + author + ", a " + cleanJobTitle + " specializing in the 0-to-1 phase of systems engineering. Highlights in co-design, compilers, and technical leadership.";
const keywords = author + " résumé, CV, systems software engineer, technical lead, hardware-software co-design, compiler engineer, platform enablement, RISC-V expertise";
const localImage = "/og/resume.png";

// Textual content comes from src/content/pages/resume-overview/, in three
// parts around the structural download button.
const Intro = await getPageBody("resume-overview", "intro");
const Highlights = await getPageBody("resume-overview", "highlights");
const Value = await getPageBody("resume-overview", "value");
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  localImage={localImage}
>
  <section class="card">
    <Intro />

    <Link href="/resume" download class="cta-button">
      Download Résumé (PDF)
    </Link>

    <!-- Structure-level separation before the typst parts; mt-8 keeps the
         rule clear of the inline button -->
    <hr class="mt-8 border-muted" />

    <Highlights />
    <Value />
  </section>
</BaseLayout>
