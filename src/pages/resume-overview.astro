---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link';

import {
  author,
  jobTitle,
  cleanJobTitle
} from '../config/site.ts';


const title = "Résumé Overview | " + author + " - " + jobTitle;
const description = "Download or view the résumé of " + author + ", a " + cleanJobTitle + " specializing in the 0-to-1 phase of systems engineering. Highlights in co-design, compilers, and technical leadership.";
const keywords = author + " résumé, CV, systems software engineer, technical lead, hardware-software co-design, compiler engineer, platform enablement, RISC-V expertise";
const localImage = "/og/resume.png";
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  localImage={localImage}
>
  <section class="card">
    <!-- Text Content -->
    <div>
      <h1>Résumé Overview</h1>

      <p>
        I am a <strong>Software Engineer & Architect</strong> specializing in the Hardware-Software Bridge. My work focuses on the <strong>"0 to 1" phase</strong> of complex systems — building the compilers, simulators, and embedded firmware that allow hardware and software to evolve as a <strong>joint ecosystem</strong>.
      </p>

      <Link href="/resume" download class="cta-button">
        Download Résumé (PDF)
      </Link>

      <h2 class="muted-top-rule">Professional Highlights</h2>

      <ul>
        <li><strong>Specialization:</strong> Hardware-software co-design, RISC-V platforms, and system-level architecture.</li>
        <li><strong>Technical Expertise:</strong> Development of LLVM-based toolchains, high-fidelity system simulators, and modular embedded firmware.</li>
        <li><strong>Leadership:</strong> Expert Software Engineer and Lead Architect at <strong>Imsys</strong>, focusing on cross-functional alignment and strategic project delivery.</li>
        <li><strong>Education:</strong> MSc in Computer Science (Graduated with Distinction), <Link href="https://www.elte.hu/en/">Eötvös Loránd University</Link>, Budapest</li>
      </ul>

      <h2>The Value I Bring</h2>

      <p>
        Beyond technical implementation, I prioritize <strong>shared understanding</strong> and <strong>structural integrity</strong>. I thrive in remote-first, deep-tech environments where I can establish clear processes and turn ambiguous hardware constraints into purposeful software solutions.
      </p>

      <p class="muted-top-rule">
        <strong>Looking for the technical proof?</strong><br />
        Explore my <Link href="/portfolio">Project Portfolio</Link> for a detailed look at my work, or visit my blog, <Link href="/blog">Defined Behavior</Link>, to read my latest thinking on engineering precision.
      </p>
    </div>
  </section>
</BaseLayout>
